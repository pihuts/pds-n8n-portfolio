# Only needed if you prefer an env var over the n8n credential UI.
# RECOMMENDED: add the key in n8n as a Header-Auth credential
#   Name: x-goog-api-key   Value: <your Gemini API key>
# and select it on the Gemini Vision Extract node (works on Cloud too).
# Copy to your n8n host environment (never commit the real file)
GEMINI_API_KEY=PASTE_YOUR_GEMINI_KEY_HERE
