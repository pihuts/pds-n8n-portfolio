    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Encode photo bytes for Gemini inline_data (base64) and forward the\n// binary untouched for the Drive upload right after.\nconst bin = $input.item.binary || {};\nconst key = bin.data ? 'data' : Object.keys(bin)[0];\nif (!key || !bin[key]) throw new Error('Telegram file binary missing');\nconst buffer = await this.helpers.getBinaryDataBuffer(0, key);\nconst b64data = buffer.toString('base64');\nif (!b64data || b64data.length < 100) throw new Error('Empty image buffer from Telegram file');\nconst mime = bin[key].mimeType || 'image/jpeg';\nconst prompt = 'You are a receipt OCR extractor. Read this receipt photo and reply with ONLY a compact JSON object, no markdown, no extra text. Keys and rules: merchant (store name, string, or Unknown), amount (grand total as a plain number, no currency symbols), currency (3-letter code, default PHP), receipt_date (YYYY-MM-DD as printed, or empty string if not visible), category (one of: Food, Transport, Office, Utilities, Healthcare, Shopping, Other), items (array of up to 8 short item names), confidence (0 to 1 self-score), notes (one short sentence or empty string).';\nreturn {\n  json: { image_b64: b64data, mime_type: mime, gemini_prompt: prompt },\n  binary: $input.item.binary\n};"
      },
      "id": "w2-b64",
      "name": "Photo to Base64",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2840,
        420
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Attach resolved date-folder id; carry image payload + binary forward.\nlet emit = {};\ntry { emit = $('Emit Date Folder').item.json; }\ncatch (e) { emit = { folder_id: '' }; }\nconst j = $input.item.json;\nreturn {\n  json: { ...j, date_folder_id: emit.folder_id || '', submission_date: emit.date || '' },\n  binary: $input.item.binary\n};"
      },
