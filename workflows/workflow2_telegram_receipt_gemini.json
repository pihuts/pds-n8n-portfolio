      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Pick the largest photo size, extract submission metadata, enforce size cap.\n// Output is pure JSON (no binary yet); download happens in Telegram Get File.\nconst upd = $input.item.json;\nconst msg = upd.message || {};\nconst photos = msg.photo || [];\nif (!photos.length) throw new Error('No photo in update');\nconst best = photos[photos.length - 1];\nlet cfg = {};\ntry { cfg = $('Config').item.json; } catch (e) { cfg = $('Config').first().json; }\nconst maxBytes = (Number(cfg.maxFileMB) || 15) * 1024 * 1024;\nconst from = msg.from || {};\nconst user = [from.first_name, from.last_name].filter(Boolean).join(' ').trim() || (from.username ? '@' + from.username : 'Unknown user');\nconst ts = (msg.date || Math.floor(Date.now() / 1000)) * 1000;\nconst d = new Date(ts);\nconst pad = n => String(n).padStart(2, '0');\nconst submissionDate = `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`;\nreturn {\n  json: {\n    chat_id: msg.chat?.id,\n    telegram_message_id: msg.message_id,\n    telegram_user: user,\n    file_id: best.file_id,\n    file_unique_id: best.file_unique_id,\n    file_size: best.file_size || 0,\n    oversized: (best.file_size || 0) > maxBytes,\n    max_bytes: maxBytes,\n    submission_date: submissionDate,\n    submission_iso: d.toISOString(),\n    caption: msg.caption || ''\n  }\n};"
      },
