      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Emit { date, folder_id } for the resolved submission-date folder.\n// Single object: forEach mode rejects array returns. Fallback uses .first()\n// (available in both modes) — $input.first() is NOT legal in forEach mode.\nlet meta = {};\ntry { meta = $('Extract Telegram Meta').item.json; }\ncatch (e) { meta = $('Extract Telegram Meta').first().json; }\nconst folderId = ($input.item.json && $input.item.json.id) || '';\nreturn { json: { date: meta.submission_date || '', folder_id: folderId } };"
      },
