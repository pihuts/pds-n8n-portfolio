    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Emit { path, folder_id } for this loop iteration (single object: forEach\n// mode rejects arrays). Post-loop, the join keys attachments to these by path.\nlet plan = {};\ntry { plan = $('Attach Date Folder ID').item.json; }\ncatch (e) { plan = $('Attach Date Folder ID').first().json; }\nconst senderId = ($input.item.json && $input.item.json.id) || plan.date_folder_id || '';\nreturn { json: { path: plan.path || '', folder_id: senderId } };"
      },
      "id": "w1-emit-folder",
      "name": "Emit Folder Mapping",
      "type": "n8n-nodes-base.code",
