    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Fan out: one item per attachment. Binaries are re-attached from the\n// ORIGINAL Extract output via pairedItem (the Sheets nodes in between drop\n// binaries; Code nodes and this pairing preserve them). allItems mode:\n// returning an array is correct here.\nconst extracts = $('Extract Email Fields').all();\nconst seen = new Set();\nconst out = [];\nfor (const it of $input.all()) {\n  const p = it.pairedItem;\n  const idx = (p == null) ? -1 : (typeof p === 'number' ? p : (Array.isArray(p) ? ((p[0] && p[0].item != null) ? p[0].item : -1) : p.item));\n  if (seen.has(idx)) continue;\n  seen.add(idx);\n  const ex = extracts[idx];\n  if (!ex) continue;\n  const email = ex.json || {};\n  const bins = ex.binary || {};\n  const keys = (email.attachment_keys && email.attachment_keys.length ? email.attachment_keys : Object.keys(bins).filter(k => k.startsWith('attachment_')));\n  for (const k of keys) {\n    if (!bins[k]) continue;\n    out.push({\n      json: {\n        message_id: email.message_id || '',\n        label: email.label || 'unlabeled',\n        date_received: email.date_received || 'unknown-date',\n        sender_name: email.sender_name || 'Unknown Sender',\n        sender_folder: email.sender_folder || 'Unknown Sender',\n        sender_email: email.sender_email || '',\n        subject: email.subject || '',\n        drive_folder_path: email.drive_folder_path || '',\n        original_filename: bins[k].fileName || k,\n        mime_type: bins[k].mimeType || 'application/octet-stream'\n      },\n      binary: { data: bins[k] }\n    });\n  }\n}\nreturn out;"
      },
