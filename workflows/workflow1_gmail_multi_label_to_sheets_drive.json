      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Build ONE Gmail search covering every label (single API call).\n// Skips already-processed mail so each run is incremental.\nconst cfg = $input.first().json;\nlet labels = cfg.labels;\nif (typeof labels === 'string') {\n  try { labels = JSON.parse(labels.replace(/'/g, '\"')); }\n  catch (e) { labels = labels.split(',').map(s => s.trim()).filter(Boolean); }\n}\nif (!Array.isArray(labels) || labels.length === 0) {\n  throw new Error('Config.labels must be a non-empty array, e.g. [\"label1\",\"label2\"]');\n}\nconst labelClause = '(' + labels.map(l => `label:${l}`).join(' OR ') + ')';\nconst query = `${cfg.lookback || 'newer_than:1d'} ${labelClause} -label:(${cfg.processedLabel || 'PDS/Processed'})`;\nreturn [{ json: { ...cfg, labels, query } }];"
      },
      "id": "w1-build-query",
      "name": "Build Gmail Query",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        420
      ]
    },
