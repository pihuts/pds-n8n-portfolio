    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Normalize one Gmail message -> email record. Never throws on odd headers.\n// Works with BOTH header shapes: Gmail API {name,value} and mailparser raw\n// lines {key,line} (raw mode stores the full line, e.g. 'From: John <j@x>').\nconst msg = $input.item.json;\nconst headers = {};\nfor (const h of (msg.payload?.headers || msg.headers || [])) {\n  const k = String(h.name || h.key || '').toLowerCase();\n  if (!k) continue;\n  let v = (h.value != null ? String(h.value) : String(h.line || ''));\n  if (v.toLowerCase().startsWith(k + ':')) v = v.slice(k.length + 1).trim();\n  headers[k] = v;\n}\nfunction parseFrom(raw) {\n  raw = String(raw || '');\n  const m = raw.match(/^\\s*\"?([^\"<>]*)\"?\\s*<([^<>]+)>\\s*$/);\n  if (m) return { name: (m[1] || '').trim().replace(/^\"|\"$/g, ''), email: m[2].trim().toLowerCase() };\n  const e = raw.match(/[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}/i);\n  return { name: raw.replace(/<[^>]*>/g, '').trim().replace(/^[\"']|[\"']$/g, '') || 'Unknown Sender', email: (e ? e[0] : '').toLowerCase() };\n}\nfunction sanitize(name) {\n  return String(name || 'Unknown Sender').replace(/[\\\\/:*?\"<>|\\u0000-\\u001F]/g, '').replace(/\\s+/g, ' ').trim().slice(0, 80) || 'Unknown Sender';\n}\nconst from = parseFrom(headers['from'] || msg.from);\nconst dateRaw = headers['date'] || msg.date || msg.internalDate;\nconst d = new Date(isNaN(Number(dateRaw)) ? dateRaw : Number(dateRaw));\nconst valid = !isNaN(d.getTime());\nconst pad = n => String(n).padStart(2, '0');\nconst dateReceived = valid ? `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}` : 'unknown-date';\nconst dateISO = valid ? d.toISOString() : '';\nconst labelIds = msg.labelIds || [];\nlet cfg = {};\ntry { cfg = $('Config').item.json; } catch (e) { cfg = $('Config').first().json; }\nconst cfgLabels = Array.isArray(cfg.labels) ? cfg.labels : [];\nconst matchedLabel = cfgLabels.find(l => labelIds.includes(l)) || labelIds.filter(x => !['INBOX','UNREAD','IMPORTANT','CATEGORY_PERSONAL'].includes(x))[0] || 'unlabeled';\nconst binaries = $input.item.binary || {};\nconst attachmentNames = Object.keys(binaries).filter(k => k.startsWith('attachment_'));\nconst senderFolder = sanitize(from.name);\nreturn {\n  json: {\n    message_id: msg.id || msg.threadId || '',\n    thread_id: msg.threadId || '',\n    date_received: dateReceived,\n    date_iso: dateISO,\n    label: matchedLabel,\n    sender_name: from.name || 'Unknown Sender',\n    sender_folder: senderFolder,\n    sender_email: from.email,\n    subject: headers['subject'] || msg.subject || '(no subject)',\n    snippet: String(msg.snippet || '').slice(0, 300),\n    attachment_count: attachmentNames.length,\n    attachment_keys: attachmentNames,\n    drive_folder_path: `${matchedLabel}/${dateReceived}/${senderFolder}`,\n    processed_at: new Date().toISOString()\n  },\n  binary: $input.item.binary\n};"
      },
