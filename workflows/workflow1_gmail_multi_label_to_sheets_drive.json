    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Barrier join (binary-safe): Merge appended attachment items (with binary)\n// + loop-done folder mappings {path, folder_id}. Attach folder id per path.\n// Mapping items are dropped; only attachment items flow on.\nconst maps = [];\nconst atts = [];\nfor (const item of $input.all()) {\n  if (item.json && item.json.original_filename) atts.push(item);\n  else if (item.json && item.json.path) maps.push(item.json);\n}\nif (atts.length === 0) return [];\nconst out = [];\nfor (const a of atts) {\n  const j = a.json;\n  const hit = maps.find(m => m.path === j.drive_folder_path);\n  if (!hit || !hit.folder_id) {\n    throw new Error(`No Drive folder resolved for path: ${j.drive_folder_path}`);\n  }\n  out.push({ json: { ...j, folder_id: hit.folder_id }, binary: a.binary });\n}\nreturn out;"
      },
