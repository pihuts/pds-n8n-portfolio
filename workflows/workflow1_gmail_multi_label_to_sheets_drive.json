    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Dedupe to one item per distinct Drive folder path.\n// The folder-ensure loop below runs single-item, so every lookup is unambiguous.\nconst seen = new Map();\nfor (const item of $input.all()) {\n  const j = item.json;\n  if (!j.drive_folder_path || seen.has(j.drive_folder_path)) continue;\n  seen.set(j.drive_folder_path, { json: { path: j.drive_folder_path, label: j.label, date_received: j.date_received, sender_folder: j.sender_folder } });\n}\nreturn [...seen.values()];"
      },
